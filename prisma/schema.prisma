generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ConstitutionStatus {
  DRAFT
  ACTIVE
}

model User {
  id                  String             @id @default(uuid())
  name                String
  email               String             @unique
  passwordHash        String
  onboardingCompleted Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  constitutions       Constitution[]
  customValues        Value[]
  decisions           DecisionEntry[]
  reflections         WeeklyReflection[]

  @@index([email])
}

model Constitution {
  id               String             @id @default(uuid())
  userId           String
  title            String             @default("My Personal Constitution")
  subtitle         String?
  preamble         String?
  missionStatement String?
  status           ConstitutionStatus @default(DRAFT)
  establishedAt    DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  values           ConstitutionValue[]
  principles       Principle[]
  boundaries       Boundary[]
  decisions        DecisionEntry[]
  versions         ConstitutionVersion[]
  reflections      WeeklyReflection[]

  @@index([userId])
  @@index([createdAt])
}

model Value {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  description        String?
  isSystem           Boolean             @default(false)
  userId             String?
  createdAt          DateTime            @default(now())

  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  constitutionValues ConstitutionValue[]
  decisionValues     DecisionValue[]

  @@index([userId])
  @@index([isSystem])
}

model ConstitutionValue {
  id             String       @id @default(uuid())
  constitutionId String
  valueId        String
  position       Int          @default(0)
  personalNote   String?
  createdAt      DateTime     @default(now())

  constitution   Constitution @relation(fields: [constitutionId], references: [id], onDelete: Cascade)
  value          Value        @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([constitutionId, valueId])
  @@index([constitutionId])
  @@index([valueId])
}

model Principle {
  id             String       @id @default(uuid())
  constitutionId String
  title          String
  statement      String
  category       String       @default("General")
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  constitution   Constitution @relation(fields: [constitutionId], references: [id], onDelete: Cascade)

  @@index([constitutionId])
  @@index([category])
  @@index([position])
}

model Boundary {
  id             String       @id @default(uuid())
  constitutionId String
  title          String
  description    String
  domain         String       @default("General")
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  constitution   Constitution @relation(fields: [constitutionId], references: [id], onDelete: Cascade)

  @@index([constitutionId])
  @@index([domain])
  @@index([position])
}

model DecisionEntry {
  id             String          @id @default(uuid())
  constitutionId String
  userId         String
  title          String
  context        String
  domain         String          @default("General")
  reflection     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  constitution   Constitution    @relation(fields: [constitutionId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  values         DecisionValue[]

  @@index([userId])
  @@index([constitutionId])
  @@index([createdAt])
}

model DecisionValue {
  id         String        @id @default(uuid())
  decisionId String
  valueId    String

  decision   DecisionEntry @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  value      Value         @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([decisionId, valueId])
  @@index([decisionId])
  @@index([valueId])
}

model ConstitutionVersion {
  id             String       @id @default(uuid())
  constitutionId String
  versionNumber  Int
  snapshot       Json
  note           String?
  createdAt      DateTime     @default(now())

  constitution   Constitution @relation(fields: [constitutionId], references: [id], onDelete: Cascade)

  @@unique([constitutionId, versionNumber])
  @@index([constitutionId])
  @@index([createdAt])
}

model WeeklyReflection {
  id                 String        @id @default(uuid())
  userId             String
  constitutionId     String?
  wentWell           String
  principlesFollowed String
  improvementNotes   String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  constitution       Constitution? @relation(fields: [constitutionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([constitutionId])
  @@index([createdAt])
}

